# Modelo do /opt/nfbmc/.env da nfbmc-prod. Copie, preencha e NUNCA commite o arquivo real.

# Senha do Postgres de produção. Gere com: openssl rand -hex 24
# (hex evita caracteres que quebram a DATABASE_URL)
POSTGRES_PASSWORD=

# Token do Cloudflare Tunnel "nfbmc" (a parte que começa com eyJ). Está no 1Password.
TUNNEL_TOKEN=
